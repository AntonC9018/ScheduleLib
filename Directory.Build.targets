<Project>
    <ItemGroup>
        <None Include="$(ProjectDir)data\**\*.*" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <ItemGroup Condition="'$(IncludeHelpers)' == 'true'">
        <Using Include="ScheduleLib.UnreachableHelper" Static="true" />
        <ProjectReference
            Condition="'$(MSBuildProjectFullPath)' != '$(RootPath)src\ScheduleLib.Helper\ScheduleLib.Helper.csproj'"
            Include="$(RootPath)src\ScheduleLib.Helper\ScheduleLib.Helper.csproj" />
    </ItemGroup>

</Project>
