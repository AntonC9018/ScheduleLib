<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <IncludeHelpers>true</IncludeHelpers>
    </PropertyGroup>

    <Import Project="$(RootPath)build\UserSecrets.props" />

    <ItemGroup>
        <ProjectReference Include="..\JsonWebsiteSchedule\JsonWebsiteSchedule.csproj" />
        <ProjectReference Include="..\ScheduleLib\ScheduleLib.csproj" />
        <ProjectReference Include="..\ScheduleDefaults\ScheduleDefaults.csproj" />
        <ProjectReference Include="..\OnlineRegistry\OnlineRegistry.csproj" />
        <ProjectReference Include="..\CurriculumDownload\CurriculumDownload.csproj" />
        <ProjectReference Include="..\CurriculumShared\CurriculumShared.csproj" />
        <ProjectReference Include="..\ConvertDocToDocxLibrary\ConvertDocToDocxLibrary.csproj" />
        <ProjectReference Include="..\MoodleInterop\MoodleInterop.csproj" />
        <ProjectReference Include="..\LayeredConfig\Anton.LayeredConfig.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="data\**\*.docx"
            Exclude="data\**\~$*.docx"
            CopyToOutputDirectory="Always"
            CopyToPublishDirectory="Always" />
        <None
            Include="data\**\*.xlsx"
            CopyToOutputDirectory="Always"
            CopyToPublishDirectory="Always" />
        <None
            Include="data\topics\**\*"
            CopyToOutputDirectory="Always"
            CopyToPublishDirectory="Always" />
        <None Update="data\2025_sem1\fr.xlsx">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
        <None Update="data\2025_sem1\fr\fr.xlsx">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
        <None Update="data\2024_sem2\zi\master.docx">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
          <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <DotNetCliToolReference Include="Microsoft.Extensions.SecretManager.Tools" Version="2.0.0" />
        <PackageReference Include="OpenXmlPowerTools.Core" Version="1.0.0" />
        <PackageReference Include="AngleSharp" Version="1.2.0" />
        <PackageReference Include="System.Linq.Async" Version="6.0.1" />
        <PackageReference Include="SpreadCheetah" Version="1.22.0" />
        <PackageReference Include="ClosedXML" Version="0.105.0" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MicrosoftPackagesVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Apis.Auth" Version="1.71.0" />
        <PackageReference Include="Google.Apis.Drive.v3" Version="1.71.0.3905" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.1.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Anton.AutoConstructor.SourceGenerator" Version="1.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="data\2025_sem1\zi\" />
    </ItemGroup>
</Project>
