<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.MainWindow"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Desktop.MainWindow.AddUserView"
        x:DataType="vm:AddUserViewModel">

    <StackPanel>
      <TextBlock Text="User Name To Add:" />
      <AutoCompleteBox
        SearchText="{Binding UserNameToAdd, Mode=TwoWay}"
        SelectedItem="{Binding SelectedUserName, Mode=OneWayToSource}"
        ItemsSource="{Binding FilteredUserNames}"
        IsEnabled="{Binding CanSelectUserToAdd}"
        MinimumPrefixLength="0"
        IsTextCompletionEnabled="False"
        />

      <Button
        Content="Click to create new UI layer"
        Command="{Binding AddUserWithTypedNameCommand}" />
    </StackPanel>
</UserControl>
