<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Desktop.NodeData.Common"
        x:Class="Desktop.Views.NodeDataVmHostView"
        x:DataType="common:INodeDataVmHost">

  <Panel IsEnabled="{Binding IsEditable}">
    <ContentControl Content="{Binding Inner}" />
  </Panel>
</UserControl>
