<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.NodeData.Editor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Desktop.NodeData.Editor.NodeDataEditorView"
        x:DataType="vm:NodeDataEditorViewModel">

  <StackPanel>
    <TextBlock Text="Layer Level" />
    <ComboBox
      ItemsSource="{Binding ConfigTypes}"
      SelectedItem="{Binding CurrentConfigType}" />

    <ContentControl Content="{Binding SelectedNodeEditorViewModel}" />
  </StackPanel>
</UserControl>
