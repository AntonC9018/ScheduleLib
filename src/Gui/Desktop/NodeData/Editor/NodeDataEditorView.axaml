<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.NodeData.Editor"
             x:Class="Desktop.NodeData.Editor.NodeDataEditorView"
             x:DataType="vm:NodeDataEditorViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="6">
      <TextBlock Text="Configuration" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding ConfigTypes}"
                SelectedItem="{Binding CurrentConfigType}"
                HorizontalAlignment="Stretch" />
    </StackPanel>
    <ContentControl Content="{Binding SelectedNodeEditorViewModel}" />
  </StackPanel>
</UserControl>
