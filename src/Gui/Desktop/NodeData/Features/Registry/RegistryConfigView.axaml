<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.NodeData.Features.Registry"
             x:Class="Desktop.NodeData.Features.Registry.RegistryConfigView"
             x:DataType="vm:RegistryConfigViewModel">
  <StackPanel Spacing="24">
    <StackPanel Spacing="8">
      <TextBlock Text="Processing" FontSize="18" FontWeight="SemiBold" />
      <CheckBox Content="Dry run" IsChecked="{Binding DryRun}" IsThreeState="True" />
      <TextBlock Text="Preview changes without updating the online registry. An indeterminate value uses the inherited setting."
                 TextWrapping="Wrap" Opacity="0.65" />
    </StackPanel>
    <Separator />
    <StackPanel Spacing="12">
      <TextBlock Text="Registry credentials" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="Login" />
        <TextBox Text="{Binding Credentials.Login}" Watermark="Registry login"
                 AutomationProperties.Name="Registry login" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="Password" />
        <TextBox Text="{Binding Credentials.Password}" PasswordChar="●" Watermark="Registry password"
                 AutomationProperties.Name="Registry password" />
      </StackPanel>
    </StackPanel>
    <Separator />
    <StackPanel Spacing="12">
      <TextBlock Text="Lesson synchronization" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="6">
        <TextBlock Text="Extra lessons in the registry" />
        <ComboBox ItemsSource="{Binding ExtraLesson.Values, Mode=OneTime}"
                  SelectedItem="{Binding ExtraLesson.Value}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Text="Compare lessons" />
        <ComboBox ItemsSource="{Binding Derivation.Values, Mode=OneTime}"
                  SelectedItem="{Binding Derivation.Value}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <TextBlock Text="Choose Default to inherit the setting from earlier layers."
                 TextWrapping="Wrap" Opacity="0.65" />
    </StackPanel>
  </StackPanel>
</UserControl>
