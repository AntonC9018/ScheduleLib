<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.NodeData.Features.Registry"
             x:Class="Desktop.NodeData.Features.Registry.CredentialsPropertyView"
             x:DataType="vm:CredentialsPropertyViewModel">
  <StackPanel Spacing="12">
    <StackPanel Spacing="6">
      <TextBlock Text="Login" />
      <TextBox Text="{Binding Login}" Watermark="Registry login" AutomationProperties.Name="Registry login" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="Password" />
      <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Registry password" AutomationProperties.Name="Registry password" />
    </StackPanel>
  </StackPanel>
</UserControl>
