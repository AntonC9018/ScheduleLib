<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Desktop.Views.RegistryConfigView"
        x:DataType="vm:RegistryConfigViewModel">

  <StackPanel>
    <TextBlock Text="Dry Run"/>
    <CheckBox IsChecked="{Binding DryRun}"/>

    <TextBlock Text="Credentials"/>
    <TextBlock Text="Login"/>
    <TextBox Text="{Binding Credentials.Login}"></TextBox>
    <TextBlock Text="Password"/>
    <TextBox Text="{Binding Credentials.Password}"></TextBox>
  </StackPanel>
</UserControl>
