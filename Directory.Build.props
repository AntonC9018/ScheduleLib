<Project>
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootPath>$(MSBuildThisFileDirectory)</RootPath>
        <FeaturesPath>$(RootPath)src\Features\</FeaturesPath>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <WindowsTarget>$(TargetFramework)-windows</WindowsTarget>
    </PropertyGroup>

    <PropertyGroup>
        <ProjectPathRelative>$([MSBuild]::MakeRelative('$(RootPath)', '$(MSBuildProjectDirectory)'))</ProjectPathRelative>
        <ProjectPathRelativeNorm>$(ProjectPathRelative.Replace('\', '/'))</ProjectPathRelativeNorm>
        <IsTestProject>false</IsTestProject>
        <IsTestProject Condition="
            $(ProjectPathRelativeNorm.StartsWith('Tests/')) Or
            $(ProjectPathRelativeNorm.Contains('/Tests/')) Or
            $(ProjectPathRelativeNorm.EndsWith('/Tests')) Or
            '$(ProjectPathRelativeNorm)' == 'Tests'
        ">true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup>
        <MicrosoftPackagesVersion>10.0.1</MicrosoftPackagesVersion>
    </PropertyGroup>

</Project>
